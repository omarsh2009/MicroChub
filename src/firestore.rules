rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // This can only be used for get/update/delete, not list.
    function isResourceOwner() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // This is for create operations.
    function isRequestOwner() {
       return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    function isAdmin() {
      // Note: This function uses get() and cannot be used in rules for queries (list operations).
      // It should only be used for get, create, update, delete on single documents.
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // --- Public & Admin-Managed Collections ---
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /payment_methods/{paymentMethodId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // --- User-Specific Data ---
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin(); // Only admins can list users.
      allow create: if request.auth.uid == userId;
      allow update: if (request.auth.uid == userId && !("role" in request.resource.data)) || isAdmin();
      allow delete: if isAdmin();

      // Subcollections can be read/written by the parent user.
      match /addresses/{addressId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /wishlist_items/{wishlistItemId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // --- Shared Data Collections ---
    
    // ORDERS
    match /orders/{orderId} {
      // Users can read (get+list) and update their own orders.
      // The list query from the client MUST have a `where('userId', '==', request.auth.uid)` clause.
      allow read, update: if request.auth.uid == resource.data.userId;
      
      // Admins can get, update, and delete any single order. They cannot list all orders.
      allow get, update, delete: if isAdmin();

      // Users can create orders for themselves.
      allow create: if isRequestOwner();
    }
    
    // CUSTOM SERVICE REQUESTS
    match /custom_service_requests/{customServiceRequestId} {
      // Users can read (get+list) and update their own requests.
      allow read, update: if request.auth.uid == resource.data.userId;
      
      // Admins can get, update, and delete any single request. They cannot list all requests.
      allow get, update, delete: if isAdmin();

      // Users can create requests for themselves.
      allow create: if isRequestOwner();
    }
    
    // QUOTE REQUESTS
    match /quote_requests/{quoteRequestId} {
      // Users can read (get+list) and update their own requests.
      allow read, update: if request.auth.uid == resource.data.userId;
      
      // Admins can get, update, and delete any single request. They cannot list all requests.
      allow get, update, delete: if isAdmin();

      // Users can create requests for themselves.
      allow create: if isRequestOwner();
    }
  }
}
