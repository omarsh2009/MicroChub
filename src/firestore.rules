rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // This can only be used for get/update/delete on a single document, not list queries.
    function isResourceOwner() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // This is for create operations where resource.data does not exist yet.
    function isRequestOwner() {
       return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    function isAdmin() {
      // This function uses get() and CANNOT be used in rules for queries (list operations).
      // It should only be used for get, create, update, delete on single documents.
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // --- Public & Admin-Managed Collections ---
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /payment_methods/{paymentMethodId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- User-Specific Data ---
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin(); // Only admins can list all users.
      allow create: if request.auth.uid == userId; // User creates their own doc.
      // User can update their own doc, but not change role. Admin can update anything.
      allow update: if (request.auth.uid == userId && resource.data.role == request.resource.data.role) || isAdmin();
      allow delete: if isAdmin();

      // For subcollections, the owner is determined by the {userId} in the path.
      match /addresses/{addressId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /wishlist_items/{wishlistItemId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // --- Shared Data Collections ---
    
    // ORDERS
    match /orders/{orderId} {
      allow get: if isResourceOwner() || isAdmin();
      allow list: if isSignedIn(); // Client MUST filter by userId
      allow create: if isRequestOwner();
      allow update: if isResourceOwner() || isAdmin();
      allow delete: if isAdmin();
    }
    
    // CUSTOM SERVICE REQUESTS
    match /custom_service_requests/{customServiceRequestId} {
      allow get: if isResourceOwner() || isAdmin();
      allow list: if isSignedIn(); // Client MUST filter by userId
      allow create: if isRequestOwner();
      allow update: if isResourceOwner() || isAdmin();
      allow delete: if isAdmin();
    }
    
    // QUOTE REQUESTS
    match /quote_requests/{quoteRequestId} {
      allow get: if isResourceOwner() || isAdmin();
      allow list: if isSignedIn(); // Client MUST filter by userId
      allow create: if isRequestOwner();
      allow update: if isResourceOwner() || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
