rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isResourceOwner() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    function isRequestOwner() {
       return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    function isAdmin() {
      // Note: This function uses get() and cannot be used in rules for queries (list operations).
      // It should only be used for get, create, update, delete on single documents.
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // --- Public & Admin-Managed Collections ---
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /payment_methods/{paymentMethodId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // --- User-Specific Data ---
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin(); // Only admins can list users.
      allow create: if request.auth.uid == userId;
      allow update: if (request.auth.uid == userId && !("role" in request.resource.data)) || isAdmin();
      allow delete: if isAdmin();

      // Subcollections can be read/written by the parent user.
      match /addresses/{addressId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /wishlist_items/{wishlistItemId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // --- Shared Data Collections ---
    match /orders/{orderId} {
      // User can get their own order. Admin can get any order.
      allow get: if isResourceOwner() || isAdmin();
      // User can list their own orders (query must include `where('userId', '==', request.auth.uid)`).
      // Admin CANNOT list all orders from the client.
      allow list: if isSignedIn();
      allow create: if isRequestOwner();
      allow update: if isResourceOwner() || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /custom_service_requests/{customServiceRequestId} {
      allow get: if isResourceOwner() || isAdmin();
      allow list: if isSignedIn();
      allow create: if isRequestOwner();
      allow update: if isResourceOwner() || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /quote_requests/{quoteRequestId} {
      allow get: if isResourceOwner() || isAdmin();
      allow list: if isSignedIn();
      allow create: if isRequestOwner();
      allow update: if isResourceOwner() || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
