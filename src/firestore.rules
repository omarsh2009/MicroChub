rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isResourceOwner() {
      // Use this for get/update on a specific document.
      // CANNOT be used for list queries.
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    function isRequestOwner() {
       // Use this for create operations.
       return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    function isAdmin() {
      // Use this for get/update/delete on a specific document.
      // CANNOT be used for list queries as it performs a `get`.
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // --- Public & Admin-Managed Collections ---
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /payment_methods/{paymentMethodId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- User-Specific Data ---
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if (request.auth.uid == userId && resource.data.role == request.resource.data.role) || isAdmin();
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /wishlist_items/{wishlistItemId} {
        // Users can only access their own wishlist items.
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // --- Shared Data Collections ---
    // The key here is to separate rules for users from rules for admins to avoid
    // the `isAdmin()` function (which does a `get`) from being evaluated during
    // a user's `list` query.
    
    // ORDERS
    match /orders/{orderId} {
      // User-specific rules that do NOT use `get` or `exists`.
      allow list: if isSignedIn(); // Allows a user's query `where('userId', '==', uid)` to pass.
      allow create: if isRequestOwner();
      
      // These rules CAN use `get` because they operate on a single document.
      allow get, update: if isResourceOwner();
      
      // Admin-specific rules. These use `get` and will only be evaluated for admins.
      // Because they are in separate allow statements, they will not block the user's `list` query.
      allow get, update, delete: if isAdmin();
    }
    
    // QUOTE REQUESTS
    match /quote_requests/{quoteRequestId} {
      allow list: if isSignedIn();
      allow create: if isRequestOwner();
      allow get, update: if isResourceOwner();
      allow get, update, delete: if isAdmin();
    }
    
    // CUSTOM SERVICE REQUESTS
    match /custom_service_requests/{customServiceRequestId} {
      allow list: if isSignedIn();
      allow create: if isRequestOwner();
      allow get, update: if isResourceOwner();
      allow get, update, delete: if isAdmin();
    }
  }
}
