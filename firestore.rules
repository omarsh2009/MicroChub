rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Safely check for admin role on the user's document.
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // --- Public & Admin-Managed Collections ---
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /payment_methods/{paymentMethodId} {
      allow get, list: if true; // Publicly readable for checkout
      allow write: if isAdmin(); // Only admins can manage payment methods
    }

    // --- User-Specific Data ---
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if (request.auth.uid == userId && !("role" in request.resource.data)) || isAdmin();
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /wishlist_items/{wishlistItemId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // --- Shared Data Collections ---

    match /orders/{orderId} {
      allow create: if request.auth.uid == request.resource.data.userId;
      
      // Admins can get/update/delete any single order
      allow get, update, delete: if isAdmin();
      
      // Users can read/update their own orders. This allows `list` with a `where` clause.
      allow read, update: if request.auth.uid == resource.data.userId;
    }
    
    match /custom_service_requests/{customServiceRequestId} {
      allow create: if request.auth.uid == request.resource.data.userId;
      // Admins can get/update/delete any single request
      allow get, update, delete: if isAdmin();
      // Users can read/update their own requests
      allow read, update: if request.auth.uid == resource.data.userId;
    }
    
    match /quote_requests/{quoteRequestId} {
      allow create: if request.auth.uid == request.resource.data.userId;
      // Admins can get/update/delete any single request
      allow get, update, delete: if isAdmin();
      // Users can read/update their own requests
      allow read, update: if request.auth.uid == resource.data.userId;
    }
  }
}
