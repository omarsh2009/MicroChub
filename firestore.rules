/**
 * Core Philosophy:
 * This ruleset enforces a strict, multi-layered security model for an e-commerce application.
 * It combines path-based ownership for private user data, denormalized ownership for shared data like orders,
 * and a role-based system for administrators managed via a field on the user's document.
 * The primary goal is to ensure users can only access their own information, while allowing administrators broad oversight.
 *
 * Data Structure:
 * The data is structurally segregated into three main types:
 * 1. Public Read-Only Collections: Top-level collections like `/products` and `/categories` contain public catalog
 *    data that anyone can read, but no one can write to from the client.
 * 2. Private User Subcollections: User-specific data such as addresses and wishlists are nested under
 *    `/users/{userId}`. Security is inherited directly from the path, ensuring strict ownership.
 * 3. Shared Top-Level Collections: Collections like `/orders` and `/custom_service_requests` are at the top level
 *    to facilitate admin queries. Security for these documents relies on a denormalized `userId` field within
 *    each document, granting access to the owner and administrators.
 *
 * Key Security Decisions:
 * - Default Deny: All paths are closed by default. Access is granted explicitly.
 * - User Data Privacy: A user can only ever access data under their own `/users/{userId}` path or documents
 *   in other collections that explicitly reference their user ID. Listing all users is disallowed for non-admins.
 * - Admin Access: Administrator privileges are managed by a 'role' field (e.g., 'admin', 'super_admin') within each user's
 *   document in the `/users` collection. This aligns security rules directly with the application's data model.
 * - Client-Side Writes: Write operations on public catalog data (`/products`, `/categories`, etc.) are completely
 *   disallowed from the client to protect data integrity. These must be managed via a trusted backend server.
 * - Relational Integrity: On creation of new documents, rules validate that ownership fields (like `userId`)
 *   are set correctly. On update, these ownership fields are made immutable to prevent re-association.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     * Used for path-based ownership checks (e.g., /users/{userId}).
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * Combines an ownership check with an existence check for the document.
     * CRITICAL for safe update and delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    /**
     * Checks if the authenticated user has an admin or super_admin role.
     * This is determined by reading the 'role' field from the user's own profile document.
     */
    function isAdmin() {
      // Security: This requires a 'get' call on every check, but aligns with app logic.
      // The user's profile must exist for this to succeed.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    /**
     * Checks if the user is the owner of a parent Order document.
     * Used to secure list and create operations on the order_items subcollection.
     */
    function isOrderOwner(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
    }

    /**
     * Retrieves the data of a parent order document.
     * Used for checks on order_items subcollection.
     */
    function getParentOrderData(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    /**
     * Validates that a user is creating their own user profile document.
     * Ensures the document ID and internal `id` field match the user's auth UID.
     */
    function isCreatingOwnUserDoc(userId) {
      return isOwner(userId) && request.resource.data.id == userId;
    }

    /**
     * Validates that the internal `id` field of a user document is immutable on update.
     */
    function isUpdatingOwnUserDoc() {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * Validates that a user is creating a child document under their own data tree.
     * Ensures the child document's `userId` field correctly points to the parent user.
     */
    function isCreatingOwnChildDoc(userId) {
      return request.resource.data.userId == userId;
    }
    
    /**
     * Validates that the `userId` field of a child document is immutable on update.
     */
    function isUpdatingOwnChildDoc() {
      return request.resource.data.userId == resource.data.userId;
    }

    // -------------------------------------------------------------------------
    // Public Read-Only Collections (Product Catalog)
    // -------------------------------------------------------------------------

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /product_configuration_options/{optionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /product_configuration_values/{valueId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // User Data Collections (/users/{userId}/...)
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Only admins can list all users.
      allow create: if isCreatingOwnUserDoc(userId);
      allow update: if isOwner(userId) || isAdmin(); // Allow self or admin updates.
      allow delete: if isAdmin(); // Only admins can delete user profiles.

      match /addresses/{addressId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isCreatingOwnChildDoc(userId);
        allow update: if isExistingOwner(userId) && isUpdatingOwnChildDoc();
        allow delete: if isExistingOwner(userId);
      }

      match /wishlist_items/{wishlistItemId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isCreatingOwnChildDoc(userId);
        allow update: if false;
        allow delete: if isExistingOwner(userId);
      }
      
      match /carts/{cartId} {
         allow get, list: if isOwner(userId);
         allow create: if isOwner(userId) && isCreatingOwnChildDoc(userId);
         allow update: if isExistingOwner(userId) && isUpdatingOwnChildDoc();
         allow delete: if isExistingOwner(userId);
         
         match /cart_items/{cartItemId} {
           allow get, list: if isOwner(userId);
           allow create: if isOwner(userId) && request.resource.data.cartId == cartId;
           allow update: if isExistingOwner(userId) && request.resource.data.cartId == resource.data.cartId;
           allow delete: if isExistingOwner(userId);
         }
      }
    }

    // -------------------------------------------------------------------------
    // Shared Data Collections (Orders, Service Requests)
    // -------------------------------------------------------------------------
    
    match /orders/{orderId} {
      // Admins can read any order. Users can read their own.
      // List operations from non-admins must include `where('userId', '==', request.auth.uid)`.
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if isAdmin() || isOwner(request.resource.data.userId) || isOwner(resource.data.userId);
      
      match /order_items/{orderItemId} {
        allow read: if isAdmin() || isOrderOwner(orderId);
        allow write: if isAdmin() || isOrderOwner(orderId);
      }
    }
    
    match /custom_service_requests/{customServiceRequestId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if isAdmin() || isOwner(request.resource.data.userId) || isOwner(resource.data.userId);
    }
    
    match /quote_requests/{quoteRequestId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if isAdmin() || isOwner(request.resource.data.userId) || isOwner(resource.data.userId);
    }
    
    // -------------------------------------------------------------------------
    // Administrative Collections
    // -------------------------------------------------------------------------

    /**
     * @description This collection was previously used for role management but is now deprecated.
     * Roles are managed via the 'role' field on a user's document in the '/users' collection.
     * @principle Deprecated. All access is denied.
     */
    match /roles_admin/{adminId} {
      allow read, write: if false;
    }
  }
}
