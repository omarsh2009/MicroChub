rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Safely check for admin role on the user's document.
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // --- Public & Admin-Managed Collections ---
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /payment_methods/{paymentMethodId} {
      allow get, list: if true; // Publicly readable for checkout
      allow write: if isAdmin(); // Only admins can manage payment methods
    }

    // --- User-Specific Data ---
    match /users/{userId} {
      // Admins can read any user profile. Users can only read their own.
      allow get: if isOwner(userId) || isAdmin();
      // Only admins can list all users.
      allow list: if isAdmin();
      // Users can create their own profile.
      allow create: if isOwner(userId);
      // Admins can update any profile. Users can update their own, but cannot change their role.
      allow update: if (isOwner(userId) && !("role" in request.resource.data)) || isAdmin();
      // Only admins can delete users.
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
      match /wishlist_items/{wishlistItemId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // --- Shared Data Collections ---

    match /orders/{orderId} {
      // Users can create their own orders.
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      // Users can read/update/delete their own orders.
      allow read, update, delete: if isOwner(resource.data.userId);
      // Admins can get/update/delete ANY order, but cannot LIST all orders.
      allow get, update, delete: if isAdmin();
    }
    
    match /custom_service_requests/{customServiceRequestId} {
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow read, update, delete: if isOwner(resource.data.userId);
      allow get, update, delete: if isAdmin();
    }
    
    match /quote_requests/{quoteRequestId} {
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      allow read, update, delete: if isOwner(resource.data.userId);
      allow get, update, delete: if isAdmin();
    }
  }
}
