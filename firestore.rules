rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Safely check for admin role on the user's document.
      // NOTE: This function can only be used to secure GET, UPDATE, DELETE requests, not LIST queries.
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // --- Public & Admin-Managed Collections ---
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /payment_methods/{paymentMethodId} {
      allow get, list: if true; // Publicly readable for checkout
      allow write: if isAdmin(); // Only admins can manage payment methods
    }

    // --- User-Specific Data ---
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if (request.auth.uid == userId && !("role" in request.resource.data)) || isAdmin();
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /wishlist_items/{wishlistItemId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // --- Shared Data Collections ---
    // The rules for these collections are simplified to prioritize user functionality.
    // Admin list queries are disabled to prevent rule evaluation conflicts.

    match /orders/{orderId} {
      // A user can read, update, or create their own order document.
      // This single rule handles get, list, create, and update for a user's own data.
      allow read, write: if request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId;
      // Admins can delete any order.
      allow delete: if isAdmin();
    }
    
    match /custom_service_requests/{customServiceRequestId} {
      // A user can read, update, or create their own service request.
      allow read, write: if request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId;
      // Admins can delete any request.
      allow delete: if isAdmin();
    }
    
    match /quote_requests/{quoteRequestId} {
      // A user can read, update, or create their own quote request.
      allow read, write: if request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId;
      // Admins can delete any request.
      allow delete: if isAdmin();
    }
  }
}
