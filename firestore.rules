rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isResourceOwner() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    function isRequestOwner() {
       return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    // Admin check uses get(), so it cannot be used in `list` rules.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // --- Public & Admin-Managed Collections ---
    match /categories/{categoryId} {
      allow get, list: if true;
      allow write: if isAdmin(); // write = create, update, delete
    }

    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /payment_methods/{paymentMethodId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // --- User-Specific Data ---
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      // Admin list query is not possible with doc-based roles. This will fail if called.
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId;
      // Users can't change their own role. Admins can change anything.
      allow update: if (request.auth.uid == userId && !("role" in request.resource.data)) || isAdmin();
      allow delete: if isAdmin();

      // Subcollections inherit userId from the parent path.
      match /addresses/{addressId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /wishlist_items/{wishlistItemId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // --- Shared Data Collections ---
    match /orders/{orderId} {
      // User can read their own orders. A `list` query must have `where('userId', '==', request.auth.uid)`.
      allow read: if isResourceOwner();
      allow create: if isRequestOwner();
      allow update: if isResourceOwner();
      // Admins can GET, UPDATE, DELETE any single order. They CANNOT list all orders.
      allow get, update, delete: if isAdmin();
    }
    
    match /custom_service_requests/{customServiceRequestId} {
      allow read: if isResourceOwner();
      allow create: if isRequestOwner();
      allow update: if isResourceOwner();
      allow get, update, delete: if isAdmin();
    }
    
    match /quote_requests/{quoteRequestId} {
      allow read: if isResourceOwner();
      allow create: if isRequestOwner();
      allow update: if isResourceOwner();
      allow get, update, delete: if isAdmin();
    }
  }
}
