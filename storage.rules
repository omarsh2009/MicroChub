rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Allow users to upload files for their quote requests.
    // They can only write to a path that contains their own UID.
    match /quote-requests/{userId}/{fileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to upload signed legal agreements for restricted products.
    match /legal-agreements/{userId}/{fileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

    